# while
i = 1 # 초기식

while i <= 5: #조건식
    print(i)
    i += 1 
    # 증감식 i = i + 1 와 동일

# 무한 반복이 발생하지 않도록 어느 시점에는 반복이 종료되도록 설계해야 함
while True:
    answer = input("숫자 입력(종료는 exit입력):")
    print(answer)
    if answer == "exit":
        break;
    print(answer)

